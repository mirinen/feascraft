---
interface Props {
  slug: string;
  title: string;
  description: string;
  fandom: string;
  category: string;
  image?: string;
}

const { slug, title, description, fandom, category, image } = Astro.props;
---

<article class="recipe-card">
  <a class="recipe-image" href={`/recipes/${slug}/`} aria-label={`Open ${title}`}>
    {image ? <img src={image} alt={title} loading="lazy" /> : <span aria-hidden="true">✦</span>}
  </a>
  <div class="recipe-card-copy">
    <div class="recipe-meta">
      <span>{fandom}</span>
      <span>{category}</span>
    </div>
    <h3><a href={`/recipes/${slug}/`}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={`/recipes/${slug}/`}>View recipe <span aria-hidden="true">→</span></a>
  </div>
</article>
