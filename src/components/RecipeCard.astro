---
interface Props {
  slug: string;
  title: string;
  description: string;
  fandom: string;
  category: string;
  image?: string;
  photoX?: number;
  photoY?: number;
  href?: string;
  linkLabel?: string;
}

const {
  slug,
  title,
  description,
  fandom,
  category,
  image,
  photoX = 50,
  photoY = 50,
  href = `/recipes/${slug}/`,
  linkLabel = "View full recipe",
} = Astro.props;
---

<article class="recipe-card">
  <a class="recipe-image" href={href} aria-label={`Open ${title}`}>
    {image ? <img src={image} style={{ objectPosition: photoX + "% " + photoY + "%" }} alt={title} loading="lazy" /> : <span aria-hidden="true">✦</span>}
  </a>
  <div class="recipe-card-copy">
    <div class="recipe-meta">
      <span>{fandom}</span>
      <span>{category}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
  </div>
</article>
