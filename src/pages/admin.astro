---
import BaseLayout from "../layouts/BaseLayout.astro";

const collections = "https://app.pagescms.org/mirinen/feascraft/main/collection";
---

<BaseLayout title="Feastcraft editor" description="Edit recipes and cooking notes for Feastcraft with Miri.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="page-hero compact editor">
    <h1>Feastcraft editor</h1>
    <p>Choose a collection. Pages CMS will ask you to sign in with GitHub.</p>
    <div class="editor-links">
      <a class="button primary" href={collections + "/recipes"}>Original Recipes</a>
      <a class="button secondary" href={collections + "/cooking-log"}>Cooking Log</a>
    </div>
    <details id="photo">
      <summary>Size a photo for upload</summary>
      <p>Choose a dish photo, then save the smaller JPEG to Files. In the recipe or log form, tap Upload and choose that file.</p>
      <input id="original" type="file" accept="image/*" aria-label="Choose a dish photo" />
      <p id="photo-status" role="status"></p>
      <a id="download" hidden>Save smaller JPEG</a>
    </details>
  </section>
</BaseLayout>

<style>
  .editor { min-height: 60vh; }
  details { margin-top: 2rem; max-width: 38rem; }
  summary { cursor: pointer; padding: .65rem 0; }
  details p { margin: .6rem 0; }
  #download:not([hidden]) { display: inline-block; padding: .75rem 0; }
  .editor-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  @media (max-width: 480px) {
    .editor-links { flex-direction: column; }
  }
</style>

<script>
  const picker = document.querySelector<HTMLInputElement>("#original")!;
  const download = document.querySelector<HTMLAnchorElement>("#download")!;
  const status = document.querySelector<HTMLElement>("#photo-status")!;
  if (location.hash === "#photo") document.querySelector<HTMLDetailsElement>("#photo")!.open = true;

  picker.addEventListener("change", async () => {
    const file = picker.files?.[0];
    if (!file) return;
    picker.disabled = true;
    if (download.hasAttribute("href")) URL.revokeObjectURL(download.href);
    download.removeAttribute("href");
    download.hidden = true;
    status.textContent = "Preparing your photo…";
    const original = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = original;
      await img.decode();
      const canvas = document.createElement("canvas");
      const scale = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight));
      canvas.width = Math.max(1, Math.round(img.naturalWidth * scale));
      canvas.height = Math.max(1, Math.round(img.naturalHeight * scale));
      const ctx = canvas.getContext("2d")!;
      ctx.fillStyle = "#fff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      for (const quality of [0.85, 0.7, 0.5, 0.3]) {
        const jpeg = await new Promise<Blob | null>(resolve => canvas.toBlob(resolve, "image/jpeg", quality));
        if (!jpeg || jpeg.size > 1000000) continue;
        download.href = URL.createObjectURL(jpeg);
        download.download = file.name.replace(/\.[^.]+$/, "") + "-feastcraft.jpg";
        download.hidden = false;
        status.textContent = "Ready (" + Math.ceil(jpeg.size / 1000) + " KB).";
        return;
      }
      status.textContent = "Try a cropped copy of this photo.";
    } catch {
      status.textContent = "Your browser could not read this photo. Try a JPEG from your photo library.";
    } finally {
      URL.revokeObjectURL(original);
      picker.disabled = false;
    }
  });
</script>
