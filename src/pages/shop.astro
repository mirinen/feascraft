---
import BaseLayout from "../layouts/BaseLayout.astro";

const storefrontUrl = "https://www.amazon.com/shop/feastcraftwithmiri?creatorsDisableRedirect=true&ccs_id=16fdd082-8fe6-4826-8d52-733c35f153f8";

const books = [
  {
    title: "World of Warcraft: The Official Cookbook",
    author: "Chelsea Monroe-Cassel",
    world: "Azeroth",
    className: "book-wow",
    url: "https://www.amazon.com/dp/160887804X?linkCode=ssc&tag=hannekaulimo-20&creativeASIN=160887804X&asc_item-id=amzn1.ideas.ET33GH98OWE4&ref_=aip_sf_list_spv_ofs_d_asin&th=1",
  },
  {
    title: "Recipes from the World of Tolkien",
    author: "Robert Tuesley Anderson",
    world: "Middle-earth",
    className: "book-tolkien",
    url: "https://www.amazon.com/dp/1645174425?linkCode=ssc&tag=hannekaulimo-20&creativeASIN=1645174425&asc_item-id=amzn1.ideas.ET33GH98OWE4&ref_=aip_sf_list_spv_ofs_d_asin&th=1",
  },
];
---

<BaseLayout
  title="Cookbooks"
  description="The fantasy cookbooks and kitchen favourites used for Feastcraft with Miri."
>
  <section class="page-hero compact shop-hero">
    <p class="eyebrow">Miri’s bookshelf</p>
    <h1>The cookbooks I use</h1>
    <p>These are the cookbooks I use for the recipes you see on Feastcraft.</p>
    <p class="affiliate-note shop-disclosure">
      As an Amazon Associate I earn from qualifying purchases.
    </p>
  </section>

  <section class="section shop-page">
    <div class="book-grid">
      {books.map((book) => (
        <article class="book-card">
          <div class={`book-cover ${book.className}`} aria-hidden="true">
            <span>{book.world}</span>
            <strong>{book.title}</strong>
          </div>
          <div class="book-card-copy">
            <p class="eyebrow">{book.world}</p>
            <h2>{book.title}</h2>
            <p>by {book.author}</p>
            <a class="button primary" href={book.url} rel="sponsored noreferrer">View on Amazon (paid link)</a>
          </div>
        </article>
      ))}
    </div>

    <aside class="storefront-callout">
      <div>
        <p class="eyebrow">Everything in one place</p>
        <h2>My Amazon storefront</h2>
        <p>The cookbooks and other things I recommend are collected on my storefront.</p>
      </div>
      <a class="button secondary" href={storefrontUrl} rel="sponsored noreferrer">My Amazon storefront (paid link)</a>
    </aside>
  </section>
</BaseLayout>
