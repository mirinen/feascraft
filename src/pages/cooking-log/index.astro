---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeCard from "../../components/RecipeCard.astro";

const posts = await getCollection("cookingLog", ({ data }) => data.published);

const entries = posts
  .map((post) => ({
    slug: post.id,
    ...post.data,
    href: `/cooking-log/${post.id}/`,
    linkLabel: "Read the cooking log",
  }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fandoms = ["All", ...new Set(entries.map((entry) => entry.fandom))];
---

<BaseLayout title="Cooking Log" description="Cookbook dishes and cooking notes from the Feastcraft kitchen.">
  <section class="page-hero compact">
    <p class="eyebrow">From the Feastcraft kitchen</p>
    <h1>Cooking log</h1>
    <p>The cookbook dishes I have made, what I changed and what I thought of them.</p>
  </section>

  <section class="section collection-section">
    <div class="filters" aria-label="Filter cooking log by fandom">
      {fandoms.map((fandom, index) => (
        <button class:list={["filter-button", { active: index === 0 }]} type="button" data-filter={fandom}>{fandom}</button>
      ))}
    </div>

    <div class="recipe-grid" id="cooking-log-grid">
      {entries.map((entry) => (
        <div data-fandom={entry.fandom}>
          <RecipeCard
            slug={entry.slug}
            title={entry.title}
            description={entry.description}
            fandom={entry.fandom}
            category={entry.category}
            image={entry.image}
            href={entry.href}
            linkLabel={entry.linkLabel}
          />
        </div>
      ))}
    </div>
    <p class="empty-state" hidden>No dishes found in this realm yet.</p>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-fandom]");
    const emptyState = document.querySelector<HTMLElement>(".empty-state");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((item) => item.classList.toggle("active", item === button));
        let visible = 0;
        cards.forEach((card) => {
          const show = filter === "All" || card.dataset.fandom === filter;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (emptyState) emptyState.hidden = visible > 0;
      });
    });
  </script>
</BaseLayout>
