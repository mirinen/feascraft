---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";

const recipes = (await getCollection("recipes", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const logPosts = await getCollection("cookingLog", ({ data }) => data.published);
const latestEntries = [
  ...logPosts.map((post) => ({
    slug: post.id,
    ...post.data,
    href: `/cooking-log/${post.id}/`,
    linkLabel: "Read the cooking log",
  })),
  ...recipes.map((recipe) => ({
    slug: recipe.id,
    ...recipe.data,
    href: `/recipes/${recipe.id}/`,
    linkLabel: "View full recipe",
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">Welcome to the tavern</p>
      <h1>
        <span>Pull up<br />a chair.</span>
        <em>Something is<br />cooking.</em>
      </h1>
      <p class="hero-intro">
        Food from World of Warcraft, World of Tolkien and all the other fictional worlds that make me
        hungry. Some recipes come from cookbooks, some are my own, and everything is made in my very
        ordinary Finnish kitchen.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/cooking-log/">Browse the cooking log <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hero-collage-placeholder" aria-label="Placeholder for a future collage of Feastcraft dishes">
      <div class="collage-grid" aria-hidden="true">
        <span>✦</span>
        <span>✧</span>
        <span>✧</span>
        <span>✦</span>
      </div>
      <p>Dish collage goes here</p>
    </div>

  </section>

  <section class="section recipes-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest from the kitchen</p>
        <h2>What I have been cooking</h2>
      </div>
      <a class="text-link desktop-link" href="/cooking-log/">View the cooking log <span aria-hidden="true">→</span></a>
    </div>
    <div class="recipe-grid">
      {latestEntries.map((entry) => (
        <RecipeCard
          slug={entry.slug}
          title={entry.title}
          description={entry.description}
          fandom={entry.fandom}
          category={entry.category}
          image={entry.image}
          href={entry.href}
          linkLabel={entry.linkLabel}
        />
      ))}
    </div>
  </section>

  <section class="shop-teaser">
    <div>
      <p class="eyebrow">Miri’s bookshelf</p>
      <h2>The cookbooks I actually use</h2>
      <p>I get asked about the books a lot, so I put them all in one place.</p>
      <p class="affiliate-note">Affiliate links: Amazon. As an Amazon Associate I earn from qualifying purchases.</p>
    </div>
    <div class="shop-teaser-actions">
      <a class="button primary" href="/shop/">See the books</a>
      <a
        class="text-link shop-storefront-link"
        href="https://www.amazon.com/shop/feastcraftwithmiri?creatorsDisableRedirect=true&ccs_id=16fdd082-8fe6-4826-8d52-733c35f153f8"
        rel="sponsored noreferrer"
      >Open my Amazon storefront <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="about-portrait-frame">
      <img
        class="about-portrait"
        src="/images/miri.jpeg"
        alt="Miri, creator of Feastcraft with Miri"
        width="880"
        height="1100"
        loading="lazy"
      />
    </div>
    <div class="about-copy">
      <p class="eyebrow">Your tavern keeper</p>
      <h2>Hi, I’m Miri.</h2>
      <p>
        I’m a lifelong nerd from Finland. Feastcraft started when I decided to cook through the World
        of Warcraft cookbook, and then my cookbook collection got slightly out of hand. Now I make food
        from games, books and films, plus my own recipes whenever the fictional version isn’t quite enough.
      </p>
      <a class="button secondary" href="https://www.tiktok.com/@feastcraftwithmiri" rel="noreferrer">Find me on TikTok</a>
    </div>
  </section>
</BaseLayout>
