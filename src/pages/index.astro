---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";

const recipes = (await getCollection("recipes", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = recipes.filter(({ data }) => data.featured).slice(0, 3);
const shownRecipes = featured.length ? featured : recipes.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">Fantasy recipes for real kitchens</p>
      <h1>
        <span>Gather<br />around.</span>
        <em>The feast is<br />ready.</em>
      </h1>
      <p class="hero-intro">
        Original recipes inspired by games, books and films. Made with a little magic, a lot of
        enthusiasm and ingredients you can actually find.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/recipes/">Explore the recipes <span aria-hidden="true">↓</span></a>
        <a class="hero-text-link" href="#about">Meet Miri <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-notes" aria-label="Miri’s recipe field notes">
      <article class="field-notes">
        <p class="eyebrow">Miri’s field notes</p>
        <h2>Recipes collected<br />from every realm</h2>
        <div class="notes-rule" aria-hidden="true"></div>
        <ul>
          <li><span aria-hidden="true">⚔</span> Boss-level comfort food</li>
          <li><span aria-hidden="true">✦</span> Tavern drinks &amp; potions</li>
          <li><span aria-hidden="true">☕</span> Cozy fantasy bakes</li>
        </ul>
        <p class="notes-footer">New quests weekly</p>
        <div class="wax-seal" aria-hidden="true"><span>FC</span></div>
      </article>
    </div>
  </section>

  <section class="section recipes-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the quest log</p>
        <h2>Featured recipes</h2>
        <p class="recipes-manifesto">
          Tested in a very ordinary kitchen.<br />
          Inspired by decidedly extraordinary worlds.
        </p>
      </div>
      <a class="text-link desktop-link" href="/recipes/">See all recipes <span aria-hidden="true">→</span></a>
    </div>
    <div class="recipe-grid">
      {shownRecipes.map((recipe) => (
        <RecipeCard
          slug={recipe.id}
          title={recipe.data.title}
          description={recipe.data.description}
          fandom={recipe.data.fandom}
          category={recipe.data.category}
          image={recipe.data.image}
        />
      ))}
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="portrait-placeholder" aria-hidden="true">
      <span>✦</span>
      <small>Your photo<br />will go here</small>
    </div>
    <div class="about-copy">
      <p class="eyebrow">Lifelong nerd • creator • kitchen adventurer</p>
      <h2>Hi, I’m Miri.</h2>
      <p>
        Feastcraft began with a love for games, books, films and the kind of food that looks like it
        belongs on a tavern table. I’m a lifelong nerd and kitchen adventurer exploring fictional worlds
        one recipe at a time and sharing what happens along the way.
      </p>
      <p>
        When I’m not cooking in the kitchen or lost in a game, my day job is in engineering.
        Apparently, I enjoy experiments, problem-solving and figuring out how things work in every realm.
      </p>
      <p>
        Here you’ll find my original recipes inspired by games, books and films. My cookbook quests
        continue on social media, where the victories, experiments and occasional kitchen chaos all make
        the final cut.
      </p>
      <a class="button secondary" href="https://www.tiktok.com/@feastcraftwithmiri" rel="noreferrer">Join the next quest</a>
    </div>
  </section>
</BaseLayout>
