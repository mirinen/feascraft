---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";

const recipes = (await getCollection("recipes", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = recipes.filter(({ data }) => data.featured).slice(0, 3);
const shownRecipes = featured.length ? featured : recipes.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">Welcome to the tavern</p>
      <h1>
        <span>Pull up<br />a chair.</span>
        <em>Something is<br />cooking.</em>
      </h1>
      <p class="hero-intro">
        Food from Azeroth and all the other fictional worlds that make me hungry. Some recipes come
        from cookbooks, some are my own, and everything is made in my very ordinary Finnish kitchen.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/recipes/">Browse the menu <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="tavern-scene" aria-hidden="true">
      <div class="window-stars"><span>✦</span><span>✧</span><span>✦</span></div>
      <div class="tavern-window">
        <div class="moon"></div>
        <div class="window-glow"></div>
      </div>
      <div class="tavern-sign">
        <span class="sign-ornament">✦</span>
        <strong>Feastcraft</strong>
        <small>with Miri</small>
      </div>
      <div class="tabletop"></div>
      <div class="candle candle-left"><span class="flame"></span></div>
      <div class="candle candle-right"><span class="flame"></span></div>
    </div>
  </section>

  <section class="section recipes-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Tonight’s specials</p>
        <h2>From the tavern kitchen</h2>
      </div>
      <a class="text-link desktop-link" href="/recipes/">View the full menu <span aria-hidden="true">→</span></a>
    </div>
    <div class="recipe-grid">
      {shownRecipes.map((recipe) => (
        <RecipeCard
          slug={recipe.id}
          title={recipe.data.title}
          description={recipe.data.description}
          fandom={recipe.data.fandom}
          category={recipe.data.category}
          image={recipe.data.image}
        />
      ))}
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="about-portrait-frame">
      <img
        class="about-portrait"
        src="/images/miri.jpeg"
        alt="Miri, creator of Feastcraft with Miri"
        width="880"
        height="1100"
        loading="lazy"
      />
    </div>
    <div class="about-copy">
      <p class="eyebrow">Your tavern keeper</p>
      <h2>Hi, I’m Miri.</h2>
      <p>
        I’m a lifelong nerd from Finland. Feastcraft started when I decided to cook through the World
        of Warcraft cookbook, and then my cookbook collection got slightly out of hand. Now I make food
        from games, books and films, plus my own recipes whenever the fictional version isn’t quite enough.
      </p>
      <a class="button secondary" href="https://www.tiktok.com/@feastcraftwithmiri" rel="noreferrer">Find me on TikTok</a>
    </div>
  </section>
</BaseLayout>
