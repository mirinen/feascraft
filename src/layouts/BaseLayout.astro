---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Feastcraft with Miri",
  description = "I’m cooking through the World of Warcraft and Tolkien cookbooks in my Finnish kitchen. Find my cooking notes and the fantasy recipes I write myself.",
} = Astro.props;

const pageTitle = title === "Feastcraft with Miri" ? title : `${title} | Feastcraft with Miri`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#21152f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Feastcraft with Miri home">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span>
          <strong>Feastcraft</strong>
          <small>with Miri</small>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/cooking-log/">Cooking Log</a>
        <a href="/recipes/">Original Recipes</a>
        <a href="/shop/">Cookbooks</a>
        <a href="/#about">About</a>
        <a href="https://www.tiktok.com/@feastcraftwithmiri" rel="noreferrer">TikTok</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <p class="footer-brand">Feastcraft with Miri</p>
        <p><a class="footer-email" href="mailto:hello@feastcraftwithmiri.com">hello@feastcraftwithmiri.com</a></p>
        <ul class="social-links" aria-label="Feastcraft social profiles">
          <li><a href="https://www.tiktok.com/@feastcraftwithmiri" rel="me">TikTok</a></li>
          <li><a href="https://www.instagram.com/feastcraftwithmiri/" rel="me">Instagram</a></li>
          <li><a href="https://www.youtube.com/@feastcraftwithmiri" rel="me">YouTube</a></li>
          <li><a href="https://www.pinterest.com/feastcraftwithmiri/" rel="me">Pinterest</a></li>
        </ul>
      </div>
      <p>Made in Finland, usually with too many cookbooks nearby.</p>
    </footer>
  </body>
</html>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold-light);
    text-underline-offset: 4px;
  }
  .social-links a:hover, .social-links a:focus-visible {
    color: var(--paper);
  }
</style>
